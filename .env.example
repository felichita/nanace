# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://nanace:nanace@127.0.0.1:5432/nanace
QDRANT_URL=http://127.0.0.1:6334
# Generate with: openssl rand -base64 48
NANACE_JWT_SECRET=change-me-to-at-least-32-random-bytes
NANACE_BIND=127.0.0.1:8080
# fastembed (local bge-small-en-v1.5) or hashing (tests/offline only)
NANACE_EMBEDDER=fastembed
FASTEMBED_CACHE_DIR=.fastembed_cache
# Externally reachable API URL; Google redirects to <url>/api/v1/auth/google/callback.
NANACE_PUBLIC_URL=http://127.0.0.1:8080
# Where the browser lands after sign-in (default: built-in <public url>/auth/complete).
# NANACE_FRONTEND_URL=http://localhost:5173/auth/callback
# Google sign-in (OAuth client of type "Web application"). Leave unset to disable.
# NANACE_GOOGLE_CLIENT_ID=
# NANACE_GOOGLE_CLIENT_SECRET=
# Comma-separated Workspace domains allowed to sign in; empty allows any verified account.
# NANACE_GOOGLE_ALLOWED_DOMAINS=example.com
# Unverified email login for development only.
NANACE_DEV_LOGIN=true
RUST_LOG=info
# Days a page stays in Trash before it is deleted for good (0 keeps it).
# NANACE_TRASH_RETENTION_DAYS=7
# text (default) or json.
# NANACE_LOG_FORMAT=json
# Prometheus /metrics on a separate listener; unset disables it.
# NANACE_METRICS_BIND=127.0.0.1:9090
